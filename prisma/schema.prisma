// Prisma schema for Multi-Vendor E-Commerce & Inventory Management Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  SELLER
  DELIVERY
  ADMIN
}

enum StoreStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAYMENT_FAILED
  PAYMENT_SUCCESSFUL
  PROCESSING
  PARTIALLY_FULFILLED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum SubOrderStatus {
  PLACED
  SELLER_ACCEPTED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String?
  phone           String?
  avatarUrl       String?   @map("avatar_url")
  passwordHash    String?   @map("password_hash") // Nullable for OAuth accounts
  oauthProvider   String?   @map("oauth_provider")
  oauthId         String?   @map("oauth_id")
  role            Role      @default(CUSTOMER)
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  store           Store?
  addresses       Address[]
  orders          Order[]

  @@index([role])
  @@map("users")
}

model Store {
  id             String      @id @default(uuid())
  sellerId       String      @unique @map("seller_id")
  storeName      String      @map("store_name")
  slug           String      @unique
  description    String?
  logoUrl        String?     @map("logo_url")
  bannerUrl      String?     @map("banner_url")
  status         StoreStatus @default(PENDING)
  commissionRate Float       @default(0.10) @map("commission_rate")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  seller         User        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  products       Product[]
  variants       ProductVariant[]
  coupons        Coupon[]
  orderItems     OrderItem[]

  @@index([sellerId])
  @@index([status])
  @@index([slug])
  @@map("stores")
}

model Category {
  id               String     @id @default(uuid())
  parentCategoryId String?    @map("parent_category_id")
  name             String
  slug             String     @unique
  description      String?
  imageUrl         String?    @map("image_url")
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  parentCategory   Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  subCategories    Category[] @relation("CategoryHierarchy")
  products         Product[]

  @@index([parentCategoryId])
  @@index([slug])
  @@map("categories")
}

model Product {
  id          String           @id @default(uuid())
  storeId     String           @map("store_id")
  categoryId  String           @map("category_id")
  title       String
  description String
  brand       String?
  basePrice   Float            @map("base_price") // Display reference price
  isActive    Boolean          @default(true) @map("is_active") // Soft delete flag
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  store       Store            @relation(fields: [storeId], references: [id])
  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id           String      @id @default(uuid())
  productId    String      @map("product_id")
  storeId      String      @map("store_id") // Direct store_id for tenant isolation
  sku          String      @unique
  variantPrice Float       @map("variant_price")
  stock        Int
  attributes   Json        // e.g. { "size": "L", "color": "Blue" }
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  product      Product     @relation(fields: [productId], references: [id])
  store        Store       @relation(fields: [storeId], references: [id])
  orderItems   OrderItem[]

  @@map("product_variants")
}

model Coupon {
  id            String       @id @default(uuid())
  storeId       String       @map("store_id")
  code          String       @unique
  discountType  DiscountType @map("discount_type")
  discountValue Float        @map("discount_value")
  minOrderValue Float        @default(0) @map("min_order_value")
  maxUses       Int          @default(100) @map("max_uses")
  usedCount     Int          @default(0) @map("used_count")
  expiresAt     DateTime?    @map("expires_at")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  store         Store        @relation(fields: [storeId], references: [id])
  orders        Order[]

  @@map("coupons")
}

model Address {
  id            String   @id @default(uuid())
  customerId    String   @map("customer_id")
  recipientName String   @map("recipient_name")
  line1         String
  line2         String?
  city          String
  state         String
  postalCode    String   @map("postal_code")
  country       String   @default("India")
  phone         String
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer      User     @relation(fields: [customerId], references: [id])

  @@map("addresses")
}

model Order {
  id                       String      @id @default(uuid())
  customerId               String      @map("customer_id")
  couponId                 String?     @map("coupon_id")
  totalAmount              Float       @map("total_amount")
  discountAmount           Float       @default(0) @map("discount_amount")
  orderStatus              OrderStatus @default(AWAITING_PAYMENT) @map("order_status")
  shippingAddressSnapshot  Json        @map("shipping_address_snapshot")
  reservationExpiresAt     DateTime?   @map("reservation_expires_at")
  createdAt                DateTime    @default(now()) @map("created_at")
  updatedAt                DateTime    @updatedAt @map("updated_at")

  customer                 User        @relation(fields: [customerId], references: [id])
  coupon                   Coupon?     @relation(fields: [couponId], references: [id])
  orderItems               OrderItem[]
  payments                 Payment[]

  @@map("orders")
}

model OrderItem {
  id                         String         @id @default(uuid())
  orderId                    String         @map("order_id")
  variantId                  String         @map("variant_id")
  storeId                    String         @map("store_id")
  productTitleSnapshot       String         @map("product_title_snapshot")
  variantAttributesSnapshot  Json           @map("variant_attributes_snapshot")
  unitPrice                  Float          @map("unit_price")
  quantity                   Int
  subOrderStatus             SubOrderStatus @default(PLACED) @map("sub_order_status")
  otpCode                    String?        @map("otp_code")
  deliveredAt                DateTime?      @map("delivered_at")
  createdAt                  DateTime       @default(now()) @map("created_at")
  updatedAt                  DateTime       @updatedAt @map("updated_at")

  order                      Order          @relation(fields: [orderId], references: [id])
  variant                    ProductVariant @relation(fields: [variantId], references: [id])
  store                      Store          @relation(fields: [storeId], references: [id])

  @@map("order_items")
}

model Payment {
  id             String          @id @default(uuid())
  orderId        String          @map("order_id")
  provider       PaymentProvider
  transactionId  String          @unique @map("transaction_id")
  idempotencyKey String          @unique @map("idempotency_key")
  amount         Float
  status         PaymentStatus   @default(INITIATED)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  order          Order           @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model ProcessedEvent {
  id         String   @id @default(uuid())
  provider   String
  eventId    String   @map("event_id")
  receivedAt DateTime @default(now()) @map("received_at")

  @@unique([provider, eventId])
  @@map("processed_events")
}
